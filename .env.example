# ========================================================
# НАСТРОЙКИ TELEGRAM ДЛЯ ОТПРАВКИ ЧЕКОВ
# ========================================================

# 1. Токен вашего Telegram-бота (получите в Telegram у @BotFather командой /newbot)
# Пример: 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=""

# 2. Числовой Telegram ID аккаунта, куда должны мгновенно падать все чеки
# Пример: 123456789 (узнать свой ID можно через бота @userinfobot)
TELEGRAM_RECEIPTS_CHAT_ID=""

# Секретный PIN-код для скрытой панели управления (по умолчанию: 2026)
ADMIN_SECRET_PIN="2026"

# ========================================================
# НАСТРОЙКИ NEON (POSTGRESQL & OBJECT STORAGE)
# ========================================================
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH="production"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-2"

# ========================================================
# НАСТРОЙКИ STRIPE ДЛЯ ОПЛАТЫ КАРТАМИ (VISA / MASTERCARD)
# ========================================================
# Секретный ключ из Dashboard Stripe (начинается с sk_test_... или sk_live_...)
STRIPE_SECRET_KEY=""
# Публичный ключ Stripe (начинается с pk_test_... или pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Валюта оплаты: usd или uzs (по умолчанию: usd)
STRIPE_CURRENCY="usd"
